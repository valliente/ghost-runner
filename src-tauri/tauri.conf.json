{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ghost Runner",
  "version": "1.102.0",
  "identifier": "com.ghostrunner.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Ghost Runner",
        "width": 860,
        "height": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["gpx"],
        "name": "GPX Workout File",
        "description": "GPS eXchange Format workout file for Ghost Runner",
        "role": "Viewer"
      }
    ]
  }
}
